[user]
	name = ISUCON Player
	email = player@isucon.net

[push]
	default = current

[core]
	quotepath = false
	editor = vim
	ignorecase = false
	excludesfile = ~/.config/git/ignore

[color]
	ui = true

[alias]
    st = status
    br = branch
    ch = checkout
    sw = switch

[pull]
	rebase = false
